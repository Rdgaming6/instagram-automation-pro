# --- Copy to backend/.env (NEVER commit a filled .env) ---
PORT=3001
FRONTEND_URL=http://localhost:5173
# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # backend only, never in frontend
# Meta / Instagram Graph API
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret   # backend only
META_REDIRECT_URI=https://your-backend.example.com/auth/instagram/callback
META_WEBHOOK_VERIFY_TOKEN=choose-a-long-random-string
# Optional: encrypt tokens at rest (32-byte hex). If unset, tokens are stored
# in Supabase as-is (still server-side only); set this in production.
TOKEN_ENCRYPTION_KEY=
# --- Frontend: frontend/.env ---
# VITE_API_URL=http://localhost:3001
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
# VITE_DEMO_MODE=true   # true = demo data, false = live
